{
  "manifest_version": 2,
  "browser_specific_settings": {
    "gecko": {
      "id": "rose-pine@fennec"
    }
  },
  "name": "Ros\u00e9 Pine",
  "description": "The Ros\u00e9 Pine palette, shared with the other Rose applications.",
  "author": "Rose Open Source Endeavours",
  "version": "1.0.0",
  "icons": {
    "32": "icon.svg"
  },
  "theme": {
    "colors": {
      "frame": "#191724",
      "frame_inactive": "#191724",
      "tab_background_text": "#6e6a86",
      "tab_selected": "#312f44",
      "tab_text": "#e0def4",
      "tab_line": "#ebbcba",
      "tab_loading": "#ebbcba",
      "toolbar": "#1f1d2e",
      "toolbar_text": "#e0def4",
      "toolbar_field": "#26233a",
      "toolbar_field_text": "#e0def4",
      "toolbar_field_border": "#26233a",
      "toolbar_field_focus": "#312f44",
      "toolbar_field_text_focus": "#e0def4",
      "toolbar_field_border_focus": "#ebbcba",
      "toolbar_top_separator": "#26233a",
      "toolbar_bottom_separator": "#26233a",
      "toolbar_vertical_separator": "#26233a",
      "ntp_background": "#191724",
      "ntp_text": "#e0def4",
      "popup": "#26233a",
      "popup_text": "#e0def4",
      "popup_border": "#26233a",
      "popup_highlight": "#8c6f6e",
      "popup_highlight_text": "#e0def4",
      "sidebar": "#1f1d2e",
      "sidebar_text": "#e0def4",
      "sidebar_border": "#26233a",
      "sidebar_highlight": "#8c6f6e",
      "sidebar_highlight_text": "#e0def4",
      "button_background_hover": "#26233a",
      "button_background_active": "#312f44",
      "icons": "#6e6a86",
      "icons_attention": "#ebbcba",
      "bookmark_text": "#e0def4",
      "error_text": "#eb6f92"
    },
    "properties": {
      "color_scheme": "dark",
      "content_color_scheme": "dark"
    }
  }
}
