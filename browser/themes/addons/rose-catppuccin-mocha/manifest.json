{
  "manifest_version": 2,
  "browser_specific_settings": {
    "gecko": {
      "id": "rose-catppuccin-mocha@fennec"
    }
  },
  "name": "Catppuccin Mocha",
  "description": "The Catppuccin Mocha palette, shared with the other Rose applications.",
  "author": "Rose Open Source Endeavours",
  "version": "1.0.0",
  "icons": {
    "32": "icon.svg"
  },
  "theme": {
    "colors": {
      "frame": "#1e1e2e",
      "frame_inactive": "#1e1e2e",
      "tab_background_text": "#6c7086",
      "tab_selected": "#45475a",
      "tab_text": "#cdd6f4",
      "tab_line": "#cba6f7",
      "tab_loading": "#cba6f7",
      "toolbar": "#181825",
      "toolbar_text": "#cdd6f4",
      "toolbar_field": "#313244",
      "toolbar_field_text": "#cdd6f4",
      "toolbar_field_border": "#45475a",
      "toolbar_field_focus": "#45475a",
      "toolbar_field_text_focus": "#cdd6f4",
      "toolbar_field_border_focus": "#cba6f7",
      "toolbar_top_separator": "#45475a",
      "toolbar_bottom_separator": "#45475a",
      "toolbar_vertical_separator": "#45475a",
      "ntp_background": "#1e1e2e",
      "ntp_text": "#cdd6f4",
      "popup": "#313244",
      "popup_text": "#cdd6f4",
      "popup_border": "#45475a",
      "popup_highlight": "#6c5b8a",
      "popup_highlight_text": "#cdd6f4",
      "sidebar": "#181825",
      "sidebar_text": "#cdd6f4",
      "sidebar_border": "#45475a",
      "sidebar_highlight": "#6c5b8a",
      "sidebar_highlight_text": "#cdd6f4",
      "button_background_hover": "#313244",
      "button_background_active": "#45475a",
      "icons": "#6c7086",
      "icons_attention": "#cba6f7",
      "bookmark_text": "#cdd6f4",
      "error_text": "#f38ba8"
    },
    "properties": {
      "color_scheme": "dark",
      "content_color_scheme": "dark"
    }
  }
}
