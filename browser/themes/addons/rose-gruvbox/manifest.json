{
  "manifest_version": 2,
  "browser_specific_settings": {
    "gecko": {
      "id": "rose-gruvbox@fennec"
    }
  },
  "name": "Gruvbox Dark",
  "description": "The Gruvbox Dark palette, shared with the other Rose applications.",
  "author": "Rose Open Source Endeavours",
  "version": "1.0.0",
  "icons": {
    "32": "icon.svg"
  },
  "theme": {
    "colors": {
      "frame": "#1d2021",
      "frame_inactive": "#1d2021",
      "tab_background_text": "#928374",
      "tab_selected": "#3c3836",
      "tab_text": "#ebdbb2",
      "tab_line": "#fabd2f",
      "tab_loading": "#fabd2f",
      "toolbar": "#282828",
      "toolbar_text": "#ebdbb2",
      "toolbar_field": "#32302f",
      "toolbar_field_text": "#ebdbb2",
      "toolbar_field_border": "#3c3836",
      "toolbar_field_focus": "#3c3836",
      "toolbar_field_text_focus": "#ebdbb2",
      "toolbar_field_border_focus": "#fabd2f",
      "toolbar_top_separator": "#3c3836",
      "toolbar_bottom_separator": "#3c3836",
      "toolbar_vertical_separator": "#3c3836",
      "ntp_background": "#1d2021",
      "ntp_text": "#ebdbb2",
      "popup": "#32302f",
      "popup_text": "#ebdbb2",
      "popup_border": "#3c3836",
      "popup_highlight": "#8f7218",
      "popup_highlight_text": "#ebdbb2",
      "sidebar": "#282828",
      "sidebar_text": "#ebdbb2",
      "sidebar_border": "#3c3836",
      "sidebar_highlight": "#8f7218",
      "sidebar_highlight_text": "#ebdbb2",
      "button_background_hover": "#32302f",
      "button_background_active": "#3c3836",
      "icons": "#928374",
      "icons_attention": "#fabd2f",
      "bookmark_text": "#ebdbb2",
      "error_text": "#fb4934"
    },
    "properties": {
      "color_scheme": "dark",
      "content_color_scheme": "dark"
    }
  }
}
