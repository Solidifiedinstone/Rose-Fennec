{
  "manifest_version": 2,
  "browser_specific_settings": {
    "gecko": {
      "id": "rose-gruvbox-light@fennec"
    }
  },
  "name": "Gruvbox Light",
  "description": "The Gruvbox Light palette, shared with the other Rose applications.",
  "author": "Rose Open Source Endeavours",
  "version": "1.0.0",
  "icons": {
    "32": "icon.svg"
  },
  "theme": {
    "colors": {
      "frame": "#fbf1c7",
      "frame_inactive": "#fbf1c7",
      "tab_background_text": "#7c6f64",
      "tab_selected": "#d5c4a1",
      "tab_text": "#3c3836",
      "tab_line": "#b57614",
      "tab_loading": "#b57614",
      "toolbar": "#f9f5d7",
      "toolbar_text": "#3c3836",
      "toolbar_field": "#ebdbb2",
      "toolbar_field_text": "#3c3836",
      "toolbar_field_border": "#d5c4a1",
      "toolbar_field_focus": "#d5c4a1",
      "toolbar_field_text_focus": "#3c3836",
      "toolbar_field_border_focus": "#b57614",
      "toolbar_top_separator": "#d5c4a1",
      "toolbar_bottom_separator": "#d5c4a1",
      "toolbar_vertical_separator": "#d5c4a1",
      "ntp_background": "#fbf1c7",
      "ntp_text": "#3c3836",
      "popup": "#ebdbb2",
      "popup_text": "#3c3836",
      "popup_border": "#d5c4a1",
      "popup_highlight": "#dfbc8a",
      "popup_highlight_text": "#3c3836",
      "sidebar": "#f9f5d7",
      "sidebar_text": "#3c3836",
      "sidebar_border": "#d5c4a1",
      "sidebar_highlight": "#dfbc8a",
      "sidebar_highlight_text": "#3c3836",
      "button_background_hover": "#ebdbb2",
      "button_background_active": "#d5c4a1",
      "icons": "#7c6f64",
      "icons_attention": "#b57614",
      "bookmark_text": "#3c3836",
      "error_text": "#9d0006"
    },
    "properties": {
      "color_scheme": "light",
      "content_color_scheme": "light"
    }
  }
}
