{
  "manifest_version": 2,
  "browser_specific_settings": {
    "gecko": {
      "id": "rose-high-contrast@fennec"
    }
  },
  "name": "High Contrast",
  "description": "The High Contrast palette, shared with the other Rose applications.",
  "author": "Rose Open Source Endeavours",
  "version": "1.0.0",
  "icons": {
    "32": "icon.svg"
  },
  "theme": {
    "colors": {
      "frame": "#000000",
      "frame_inactive": "#000000",
      "tab_background_text": "#d0d0d0",
      "tab_selected": "#242424",
      "tab_text": "#ffffff",
      "tab_line": "#ffd400",
      "tab_loading": "#ffd400",
      "toolbar": "#000000",
      "toolbar_text": "#ffffff",
      "toolbar_field": "#141414",
      "toolbar_field_text": "#ffffff",
      "toolbar_field_border": "#ffffff",
      "toolbar_field_focus": "#242424",
      "toolbar_field_text_focus": "#ffffff",
      "toolbar_field_border_focus": "#ffd400",
      "toolbar_top_separator": "#ffffff",
      "toolbar_bottom_separator": "#ffffff",
      "toolbar_vertical_separator": "#ffffff",
      "ntp_background": "#000000",
      "ntp_text": "#ffffff",
      "popup": "#141414",
      "popup_text": "#ffffff",
      "popup_border": "#ffffff",
      "popup_highlight": "#8a7300",
      "popup_highlight_text": "#ffffff",
      "sidebar": "#000000",
      "sidebar_text": "#ffffff",
      "sidebar_border": "#ffffff",
      "sidebar_highlight": "#8a7300",
      "sidebar_highlight_text": "#ffffff",
      "button_background_hover": "#141414",
      "button_background_active": "#242424",
      "icons": "#d0d0d0",
      "icons_attention": "#ffd400",
      "bookmark_text": "#ffffff",
      "error_text": "#ff5c5c"
    },
    "properties": {
      "color_scheme": "dark",
      "content_color_scheme": "dark"
    }
  }
}
