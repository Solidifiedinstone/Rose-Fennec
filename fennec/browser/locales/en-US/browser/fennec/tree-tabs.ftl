## Tree tabs settings

fennec-tabs-tree-heading =
    .label = Tree tabs

fennec-tabs-tree-enable-toggle =
    .label = Show tabs as a tree
    .description = Tabs you open from another tab tuck in underneath it, so you can fold and move whole groups at once. This also turns on vertical tabs.

fennec-tabs-tree-auto-attach-select =
    .label = Open new tabs

fennec-tabs-tree-auto-attach-option-root =
    .label = On their own

fennec-tabs-tree-auto-attach-option-child =
    .label = Tucked under the tab that opened them

fennec-tabs-tree-auto-attach-option-sibling =
    .label = Next to the tab that opened them

fennec-tabs-tree-auto-collapse-on-select-toggle =
    .label = Open the active tab’s branch and fold the others away

fennec-tabs-tree-auto-collapse-on-attach-toggle =
    .label = Open a branch when a new tab joins it

fennec-tabs-tree-close-parent-select =
    .label = When you close a parent tab

fennec-tabs-tree-close-parent-option-promote-first =
    .label = Put its first child in its place

fennec-tabs-tree-close-parent-option-promote-all =
    .label = Lift its children up a level

fennec-tabs-tree-close-parent-option-close-all =
    .label = Close the whole branch

fennec-tabs-tree-close-parent-option-detach =
    .label = Move its children to the top level

fennec-tabs-tree-double-click-select =
    .label = Double clicking a tab

fennec-tabs-tree-double-click-option-toggle =
    .label = Folds or opens its branch

fennec-tabs-tree-double-click-option-close =
    .label = Closes its branch

fennec-tabs-tree-double-click-option-none =
    .label = Does nothing

fennec-tabs-tree-sticky-active-toggle =
    .label = Keep the current tab in view when its branch is folded away

fennec-tabs-tree-propagate-muted-toggle =
    .label = Mute a tab’s children along with it

fennec-tabs-tree-max-depth-select =
    .label = Limit how deep tabs can nest

fennec-tabs-tree-max-depth-option-unlimited =
    .label = No limit
