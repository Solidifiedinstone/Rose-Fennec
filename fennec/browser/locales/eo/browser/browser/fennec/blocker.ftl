fennec-blocker-header = Blokado de reklamoj

fennec-blocker-intro-description = Blokas reklamojn, spurantajn skriptojn, kaj aliajn nedeziratajn petojn por plirapidigi ŝarĝadon de paĝoj kaj malpliigi distraĵojn.

fennec-blocker-setting-on =
    .label = Ŝaltita

fennec-blocker-setting-on-summary = Blokas reklamojn kaj spurilojn kun minimuma efiko por funkciado de paĝoj.

fennec-blocker-setting-on-description = Fennec blokas tiujn:

